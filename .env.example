# Example environment file. Copy to `.env` and fill in values — never commit `.env`.

# DeepSeek API key used by the harness (chat + web search). Required to run the RSI loop.
DEEPSEEK_API_KEY=

# GitHub token with repo scope, used by `rsi_propose` (`gh pr create`). Optional for local dry runs.
GH_TOKEN=

# Override the host boot command (default: `dsh web`). Useful for pinning a version.
DSH_DESKTOP_HOST_CMD=

# Override the web URL probed by scripts/smoke-web.sh (default: http://127.0.0.1:3080/).
DSH_WEB_URL=
